#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Runs Spotify Soloist and keeps its binary fresh.
#
# Soloist builds expire 90 days after their build date (exit code 10). The
# binary is never shipped in this image: it is downloaded from Spotify's CDN
# at runtime and replaced when Spotify publishes a newer build.
#
#   - On start:            download if no binary is installed yet.
#   - Every check interval: fetch the archive headers; if the CDN build changed,
#                          download and verify it into a staging slot.
#   - At the update hour:  if a staged build exists, swap it in and restart.
#   - Exit code 10:        build expired; update immediately, retry until a
#                          newer build is available.
# ==============================================================================
set -o nounset -o pipefail

readonly CDN="https://soloist-builds.spotifycdn.com"
readonly BIN_DIR="/data/bin"
readonly BIN="${BIN_DIR}/soloist"
readonly STAGED="${BIN_DIR}/soloist.staged"
readonly META="${BIN_DIR}/remote.etag"
readonly STATE_DIR="/data/state"
readonly CACHE_DIR="/data/cache"
readonly EXIT_EXPIRED=10
readonly LIFETIME_DAYS=90
readonly WARN_DAYS=14

# Soloist's playback state, tracked from its own log output (see
# track_soloist_output), and the request for a last-resort restart.
# Timings are in seconds; the environment overrides them for tests.
readonly RUN_DIR="${SOLOIST_RUN_DIR:-/run/soloist}"
readonly PLAY_STATE="${RUN_DIR}/state"
readonly RESTART_FLAG="${RUN_DIR}/restart"
readonly POLL_SECS="${SOLOIST_POLL_SECS:-10}"
readonly WATCH_SECS="${SOLOIST_WATCH_SECS:-10}"
readonly FRESH_SECS="${SOLOIST_FRESH_SECS:-30}"
readonly WARN_AFTER_SECS="${SOLOIST_WARN_AFTER_SECS:-20}"
readonly RESTART_AFTER_SECS="${SOLOIST_RESTART_AFTER_SECS:-60}"
readonly COOLDOWN_SECS="${SOLOIST_COOLDOWN_SECS:-600}"
# Extra audio diagnostics, only with the verbose option: a follow-up snapshot
# after playback starts or moves, and one every PERIODIC_SECS while playing.
readonly FOLLOWUP_SECS="${SOLOIST_FOLLOWUP_SECS:-15}"
readonly PERIODIC_SECS="${SOLOIST_PERIODIC_SECS:-300}"
readonly FOLLOWUP_FILE="${RUN_DIR}/followup"

DEVICE_NAME="$(bashio::config 'device_name')"
API_KEY="$(bashio::config 'api_key')"
WS_PORT="$(bashio::config 'websocket_port')"
CHECK_HOURS="$(bashio::config 'update_check_interval_hours')"
UPDATE_HOUR="$(bashio::config 'update_hour')"
# "true" or "false"; the environment overrides the option for tests.
VERBOSE="${SOLOIST_VERBOSE:-$(bashio::config.true 'verbose' && echo true || echo false)}"

soloist_pid=""
follow_pid=""

# Watcher state (lives in the background watcher only).
output_present=""
stall_since=0
stall_warned=false
stall_restarted=false
last_restart=0
last_periodic=0

archive_url() {
    local arch
    case "$(uname -m)" in
        aarch64) arch="arm64" ;;
        armv7l | armv7*) arch="arm32" ;;
        x86_64) arch="x86_64" ;;
        *) bashio::exit.nok "Unsupported architecture: $(uname -m)" ;;
    esac
    echo "${CDN}/soloist_release_${arch}.tar.gz"
}

# Prints an identifier for the build currently on the CDN (ETag, falling
# back to Last-Modified). Empty output means the check failed.
remote_build_id() {
    curl --fail --silent --show-error --location --head --max-time 30 "$(archive_url)" \
        | tr -d '\r' \
        | awk 'tolower($1) == "etag:" { etag = $2 }
               tolower($1) == "last-modified:" { $1 = ""; lm = $0 }
               END { print (etag != "" ? etag : lm) }'
}

# Prints the build's Unix timestamp. `soloist --version` looks like:
#   soloist 1.3.9.12 build 1791741672 (20261011) (g440165f200) (linux/x86_64)
build_epoch() {
    "$1" --version 2>/dev/null | sed -n 's/.* build \([0-9][0-9]*\) .*/\1/p'
}

# True if build $1 is newer than the installed build (or none is installed).
is_newer() {
    [[ -x "${BIN}" ]] || return 0
    local new old
    new="$(build_epoch "$1")"
    old="$(build_epoch "${BIN}")"
    # If either version can't be parsed, trust the CDN change.
    [[ -z "${new}" || -z "${old}" ]] && return 0
    ((new > old))
}

log_expiry() {
    local epoch days
    epoch="$(build_epoch "${BIN}")"
    [[ -n "${epoch}" ]] || return 0
    days=$(((epoch + LIFETIME_DAYS * 86400 - $(date +%s)) / 86400))
    if ((days < WARN_DAYS)); then
        bashio::log.warning "Soloist build expires in ${days} days and no newer build is installed yet"
    else
        bashio::log.info "Soloist build expires in ${days} days"
    fi
}

# Downloads the current CDN build to $1 and checks it runs. Only the
# `soloist` member is extracted; other archive files are ignored.
download_to() {
    local target="$1" tmp
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '${tmp}'" RETURN

    bashio::log.info "Downloading Soloist from $(archive_url)"
    if ! curl --fail --silent --show-error --location --max-time 300 \
        -o "${tmp}/soloist.tar.gz" "$(archive_url)"; then
        bashio::log.warning "Download failed"
        return 1
    fi
    if ! tar -xzf "${tmp}/soloist.tar.gz" -C "${tmp}" soloist; then
        bashio::log.warning "Archive does not contain a soloist executable"
        return 1
    fi
    if [[ ! -f "${tmp}/soloist" || -L "${tmp}/soloist" ]]; then
        bashio::log.warning "Archive member soloist is not a regular file"
        return 1
    fi
    chmod 755 "${tmp}/soloist"

    local version rc=0
    version="$("${tmp}/soloist" --version 2>&1)" || rc=$?
    if ((rc != 0)); then
        bashio::log.warning "Downloaded build does not run (exit ${rc}): ${version}"
        return 1
    fi
    bashio::log.info "Downloaded build: ${version//$'\n'/ | }"

    mv -f "${tmp}/soloist" "${target}"
}

# Stages a newer CDN build if there is one. Returns 0 if a build is staged.
check_for_update() {
    local remote local_id=""
    remote="$(remote_build_id)" || true
    if [[ -z "${remote}" ]]; then
        bashio::log.warning "Could not reach the Soloist CDN; will retry later"
        [[ -x "${STAGED}" ]]
        return
    fi
    [[ -f "${META}" ]] && local_id="$(<"${META}")"
    if [[ "${remote}" == "${local_id}" && -x "${BIN}" ]]; then
        bashio::log.debug "Soloist is up to date (${remote})"
        [[ -x "${STAGED}" ]]
        return
    fi
    if [[ -x "${STAGED}" && -f "${META}.staged" && "$(<"${META}.staged")" == "${remote}" ]]; then
        return 0
    fi
    bashio::log.info "CDN build changed (${remote}); downloading"
    download_to "${STAGED}" || return 1
    if ! is_newer "${STAGED}"; then
        bashio::log.info "CDN build is not newer than the installed one; ignoring it"
        rm -f "${STAGED}"
        echo "${remote}" >"${META}"
        return 1
    fi
    echo "${remote}" >"${META}.staged"
    bashio::log.info "Newer Soloist build staged; installing at ${UPDATE_HOUR}:00"
}

apply_staged() {
    [[ -x "${STAGED}" ]] || return 1
    mv -f "${STAGED}" "${BIN}"
    [[ -f "${META}.staged" ]] && mv -f "${META}.staged" "${META}"
    bashio::log.info "Installed new Soloist build"
}

# Installs a newer build right away. Used on first start and after expiry.
# Returns 1 if the download fails or the CDN still serves the installed build.
install_now() {
    apply_staged && return 0
    local remote
    remote="$(remote_build_id)" || true
    if [[ -n "${remote}" && -x "${BIN}" && -f "${META}" && "$(<"${META}")" == "${remote}" ]]; then
        return 1
    fi
    download_to "${BIN}.new" || return 1
    if ! is_newer "${BIN}.new"; then
        rm -f "${BIN}.new"
        return 1
    fi
    mv -f "${BIN}.new" "${BIN}"
    echo "${remote}" >"${META}"
}

# Records "<playing|idle> <unix time>" in $PLAY_STATE.
set_play_state() {
    printf '%s %s\n' "$1" "$(date +%s)" >"${PLAY_STATE}.tmp" &&
        mv -f "${PLAY_STATE}.tmp" "${PLAY_STATE}"
}

# Reads Soloist's output: passes every line on to the log unchanged and
# records whether it is playing. Soloist repeats "playing" every 10 s.
track_soloist_output() {
    local line msg playing=false
    while IFS= read -r line || [[ -n "${line}" ]]; do
        echo "${line}"
        # Lines look like "2026-10-18 16:37:22.049: playing spotify:track:...".
        msg="${line#*: }"
        case "${msg}" in
            "playing "*)
                set_play_state playing
                if [[ "${playing}" == false ]]; then
                    playing=true
                    # In the background: probing the signal takes a second,
                    # and Soloist must never wait on its own log.
                    routine_snapshot "Soloist started playing" &
                fi
                ;;
            "paused "* | stopped*)
                playing=false
                set_play_state idle
                ;;
        esac
    done
}

start_soloist() {
    bashio::log.info "$("${BIN}" --version 2>&1)"
    log_expiry
    mkdir -p "${RUN_DIR}"
    set_play_state idle
    # Process substitution keeps $! the pid of Soloist itself.
    "${BIN}" \
        --device-name "${DEVICE_NAME}" \
        --api-key "${API_KEY}" \
        --data-dir "${STATE_DIR}" \
        --cache-dir "${CACHE_DIR}" \
        --ws "127.0.0.1:${WS_PORT}" \
        "${EXTRA_ARGS[@]}" > >(track_soloist_output) 2>&1 &
    soloist_pid=$!
    bashio::log.info "Soloist started as \"${DEVICE_NAME}\" (WebSocket on 127.0.0.1:${WS_PORT})"
}

stop_soloist() {
    [[ -n "${soloist_pid}" ]] || return 0
    kill -TERM "${soloist_pid}" 2>/dev/null || true
    wait "${soloist_pid}" 2>/dev/null || true
    soloist_pid=""
}

on_signal() {
    bashio::log.info "Stopping Soloist"
    [[ -n "${follow_pid}" ]] && kill "${follow_pid}" 2>/dev/null
    stop_soloist
    exit 0
}

# ---- audio output -------------------------------------------------------------
# Home Assistant applies the add-on's Audio output only to ALSA clients (via
# asound.conf). Soloist talks to PulseAudio directly, so its streams are moved
# to the selected output whenever that output exists. Forcing the output with
# PULSE_SINK instead makes playback fail while it is missing, for example
# while a USB DAC is switched off.

# Records the 1 s of audio on sink monitor $1 and prints signal=audio,
# signal=silent, or signal=? if nothing could be recorded. Bounded by timeout.
probe_signal() {
    local tmp
    tmp="$(mktemp)" || { echo "signal=?"; return 0; }
    timeout 3 parec --raw -d "$1" --format=s16le --rate=44100 --channels=2 2>/dev/null |
        head -c 176400 >"${tmp}"
    if [[ ! -s "${tmp}" ]]; then
        echo "signal=?"
    elif [[ -n "$(tr -d '\0' <"${tmp}" | head -c 1)" ]]; then
        echo "signal=audio"
    else
        echo "signal=silent"
    fi
    rm -f "${tmp}"
}

# The snapshots at routine events (playback starts or moves, an output
# appears or disappears) are only logged with verbose. The watchdog's own
# snapshot is always logged.
routine_snapshot() {
    [[ "${VERBOSE}" == true ]] && log_audio_snapshot "$1"
    return 0
}

# Logs a compact picture of the audio state, to help find out why a stream
# plays without sound: every sink, the default sink and Soloist's streams.
# With verbose, also the streams' latency and whether any sound reaches
# their sink, and a follow-up snapshot is scheduled after start and move.
log_audio_snapshot() {
    local why="$1" sinks inputs default line extra="{}" index monitor
    if ! sinks="$(pactl -f json list sinks 2>/dev/null)" ||
        ! inputs="$(pactl -f json list sink-inputs 2>/dev/null)"; then
        bashio::log.info "Audio (${why}): audio service not reachable"
        return 0
    fi
    if [[ "${VERBOSE}" == true ]]; then
        case "${why}" in
            "Soloist started playing" | "after move")
                echo "$(($(date +%s) + FOLLOWUP_SECS)) ${why}" >"${FOLLOWUP_FILE}"
                ;;
        esac
        # Streams that are not corked, with the monitor of their sink.
        while IFS=$'\t' read -r index monitor; do
            [[ -n "${monitor}" ]] || continue
            extra="$(jq -c --arg k "${index}" --arg v " $(probe_signal "${monitor}")" \
                '. + {($k): $v}' <<<"${extra}")"
        done < <(jq -r --argjson inputs "${inputs}" '
            (map({key: (.index | tostring), value: .monitor_source}) | from_entries) as $mon
            | $inputs[] | select(.properties["application.process.binary"] == "soloist"
                and .corked == false)
            | "\(.index)\t\($mon[.sink | tostring] // "")"' <<<"${sinks}" 2>/dev/null)
    fi
    default="$(pactl -f json info 2>/dev/null | jq -r '.default_sink_name // "?"')" || default="?"
    bashio::log.info "Audio (${why}): default sink ${default}"
    jq -r --argjson inputs "${inputs}" --argjson extra "${extra}" \
        --argjson verbose "${VERBOSE}" '
        def f: if . == null then "?" else . end;
        def vol: [(.volume // {})[]? | (.value_percent? | f)] | unique | join(",");
        (map({key: (.index | tostring), value: .name}) | from_entries) as $names
        | (.[] | "  sink \(.name) (#\(.index)) state=\(.state | f)"
            + " mute=\(.mute | f) volume=\(vol) latency=\(.latency.actual? | f)us"),
          ([$inputs[] | select(.properties["application.process.binary"] == "soloist")] as $own
            | if ($own | length) == 0 then "  no Soloist stream"
              else $own[] | "  Soloist stream #\(.index) on \($names[.sink | tostring] // "?")"
                + " corked=\(.corked | f) mute=\(.mute | f) volume=\(vol)"
                + (if $verbose
                    then " sink_latency=\(.sink_latency_usec | f)us buffer_latency=\(.buffer_latency_usec | f)us"
                        + ($extra[.index | tostring] // "")
                    else "" end) end)
        ' <<<"${sinks}" 2>/dev/null |
        while read -r line; do
            bashio::log.info "${line}"
        done
}

move_to_output() {
    local target="$1" sink
    sink="$(pactl -f json list sinks 2>/dev/null |
        jq -r --arg name "${target}" '.[] | select(.name == $name) | .index')" || return 0
    [[ -n "${sink}" ]] || return 0
    pactl -f json list sink-inputs 2>/dev/null |
        jq -r --argjson sink "${sink}" '.[]
            | select(.properties["application.process.binary"] == "soloist" and .sink != $sink)
            | .index' |
        while read -r input; do
            if pactl move-sink-input "${input}" "${target}"; then
                bashio::log.info "Moved playback to ${target}"
                routine_snapshot "after move"
            else
                bashio::log.warning "Could not move stream ${input} to ${target}"
            fi
        done
}

# Soloist keeps logging "playing" if it loses its PulseAudio connection (for
# example when Home Assistant's audio service restarts), but has no stream
# then. $1 is the sink-input JSON. If this persists, warn first, and restart
# Soloist as a last resort (the main loop does it, once per occurrence).
check_stream() {
    local state="" stamp=0 now
    now="$(date +%s)"
    [[ -r "${PLAY_STATE}" ]] && read -r state stamp <"${PLAY_STATE}"
    if [[ "${state}" != playing ]] || ((now - ${stamp:-0} > FRESH_SECS)) ||
        jq -e 'any(.[]; .properties["application.process.binary"] == "soloist")' \
            >/dev/null <<<"$1"; then
        stall_since=0
        stall_warned=false
        stall_restarted=false
        return 0
    fi
    ((stall_since > 0)) || stall_since="${now}"
    if [[ "${stall_warned}" == false ]] && ((now - stall_since >= WARN_AFTER_SECS)); then
        stall_warned=true
        bashio::log.warning "Soloist reports playing but has no audio stream; Home Assistant's audio service may have restarted"
        log_audio_snapshot "no Soloist stream"
    fi
    if [[ "${stall_restarted}" == false ]] && ((now - stall_since >= RESTART_AFTER_SECS)) &&
        ((now - last_restart >= COOLDOWN_SECS)); then
        stall_restarted=true
        last_restart="${now}"
        : >"${RESTART_FLAG}"
        bashio::log.warning "Soloist still has no audio stream after ${RESTART_AFTER_SECS} s; restarting it as a last resort. Spotify may need you to press play again."
    fi
}

# Verbose only. Logs the follow-up snapshot once it is due, and one every
# PERIODIC_SECS while Soloist is playing.
check_snapshots() {
    [[ "${VERBOSE}" == true ]] || return 0
    local state="" stamp=0 now due="" why=""
    now="$(date +%s)"
    if [[ -r "${FOLLOWUP_FILE}" ]]; then
        read -r due why <"${FOLLOWUP_FILE}"
        if ((now >= ${due:-0})); then
            rm -f "${FOLLOWUP_FILE}"
            log_audio_snapshot "${FOLLOWUP_SECS} s after ${why#after }"
        fi
    fi
    [[ -r "${PLAY_STATE}" ]] && read -r state stamp <"${PLAY_STATE}"
    if [[ "${state}" != playing ]] || ((now - ${stamp:-0} > FRESH_SECS)); then
        last_periodic=0
    elif ((last_periodic == 0)); then
        last_periodic="${now}"
    elif ((now - last_periodic >= PERIODIC_SECS)); then
        last_periodic="${now}"
        log_audio_snapshot "while playing"
    fi
}

# One health check. $1 is the selected output, empty for the system default.
check_audio() {
    local target="$1" sinks inputs present=false
    # If pactl fails, the audio service is down or restarting: do nothing
    # until it answers again.
    if ! sinks="$(pactl -f json list sinks 2>/dev/null)" ||
        ! inputs="$(pactl -f json list sink-inputs 2>/dev/null)" ||
        ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"${sinks}" ||
        ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"${inputs}"; then
        stall_since=0
        return 0
    fi
    if [[ -n "${target}" ]]; then
        jq -e --arg name "${target}" 'any(.[]; .name == $name)' \
            >/dev/null <<<"${sinks}" && present=true
        if [[ "${present}" != "${output_present}" ]]; then
            if [[ "${output_present}" == true ]]; then
                bashio::log.info "Output ${target} disappeared"
                routine_snapshot "output gone"
            elif [[ "${output_present}" == false ]]; then
                bashio::log.info "Output ${target} appeared"
                routine_snapshot "output back"
            fi
            output_present="${present}"
        fi
        move_to_output "${target}"
    fi
    check_stream "${inputs}"
    check_snapshots
}

# Runs in the background for the add-on's lifetime. $1 is the selected
# output; if empty, it only watches Soloist's stream and moves nothing.
watch_audio() {
    local target="$1" event rc
    while true; do
        check_audio "${target}"
        # Re-check whenever an output appears or a stream starts or changes.
        # pactl block-buffers its output into a pipe, delaying events by
        # minutes, so force line buffering. The read timeout re-checks anyway
        # in case an event is still missed.
        while true; do
            rc=0
            read -r -t "${WATCH_SECS}" event || rc=$?
            if ((rc > 128)); then
                check_audio "${target}"
            elif ((rc != 0)); then
                break
            else
                case "${event}" in
                    *"'new' on sink #"* | *"'remove' on sink #"* | *"on sink-input #"*)
                        check_audio "${target}"
                        ;;
                esac
            fi
        done < <(stdbuf -oL pactl subscribe 2>/dev/null)
        # pactl exits when Home Assistant's audio service restarts.
        sleep 5
    done
}

# Lets the test suite source the functions above without running Soloist.
[[ -n "${SOLOIST_SOURCE_ONLY:-}" ]] && return 0

# ---- main ---------------------------------------------------------------------

EXTRA_ARGS=()
if bashio::config.has_value 'initial_volume'; then
    EXTRA_ARGS+=(--initial-volume "$(bashio::config 'initial_volume')")
fi
if bashio::config.has_value 'cache_size_mb'; then
    EXTRA_ARGS+=(--cache-size "$(bashio::config 'cache_size_mb')")
fi
if [[ "${VERBOSE}" == true ]]; then
    EXTRA_ARGS+=(--verbose)
fi

audio_output=""
if declare -F bashio::app.audio_output >/dev/null; then
    audio_output="$(bashio::app.audio_output 2>/dev/null || true)"
else
    audio_output="$(bashio::addon.audio_output 2>/dev/null || true)"
fi
[[ "${audio_output}" == "null" ]] && audio_output=""

mkdir -p "${BIN_DIR}" "${STATE_DIR}" "${CACHE_DIR}"
trap on_signal TERM INT

if [[ -n "${audio_output}" ]]; then
    bashio::log.info "Audio output: ${audio_output}"
else
    bashio::log.info "Audio output: system default"
fi
watch_audio "${audio_output}" &
follow_pid=$!

if bashio::config.true 'reset_pairing'; then
    bashio::log.warning "reset_pairing is on: clearing the stored Spotify session"
    rm -rf "${STATE_DIR:?}"/*
    bashio::log.warning "Turn reset_pairing off again, or every restart will unpair"
fi

until [[ -x "${BIN}" ]]; do
    install_now && break
    bashio::log.error "Could not install Soloist; retrying in 5 minutes"
    sleep 300
done

next_check=$(($(date +%s) + CHECK_HOURS * 3600))
backoff=5
start_soloist

while true; do
    # Sleep in short steps so signals and exits are handled promptly.
    sleep "${POLL_SECS}" &
    wait $! || true

    if ! kill -0 "${soloist_pid}" 2>/dev/null; then
        rc=0
        wait "${soloist_pid}" || rc=$?
        soloist_pid=""
        rm -f "${RESTART_FLAG}"
        if ((rc == EXIT_EXPIRED)); then
            bashio::log.warning "Soloist build expired; fetching a new one"
            until install_now; do
                bashio::log.error "No newer build yet; retrying in 1 hour"
                sleep 3600
            done
            backoff=5
        else
            bashio::log.warning "Soloist exited with code ${rc}; restarting in ${backoff}s"
            sleep "${backoff}"
            backoff=$((backoff < 300 ? backoff * 2 : 300))
            # A pending update is a good fix for a crashing build.
            apply_staged || true
        fi
        start_soloist
        continue
    fi

    if [[ -f "${RESTART_FLAG}" ]]; then
        rm -f "${RESTART_FLAG}"
        bashio::log.info "Restarting Soloist to reconnect to the audio service"
        stop_soloist
        start_soloist
        continue
    fi

    if (($(date +%s) >= next_check)); then
        next_check=$(($(date +%s) + CHECK_HOURS * 3600))
        check_for_update || true
    fi

    if [[ -x "${STAGED}" ]] && ((10#$(date +%H) == UPDATE_HOUR)); then
        bashio::log.info "Applying staged Soloist update"
        stop_soloist
        apply_staged
        backoff=5
        start_soloist
    fi
done
